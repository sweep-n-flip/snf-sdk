# examples/next-app/.env.example
#
# Placeholders only. Copy to .env.local and fill in your own values if you want
# them -- every value below is optional and this app runs with none of them set.

# Your own Base RPC. Falls back to a public, keyless Base RPC when unset.
NEXT_PUBLIC_RPC_URL=

# A WalletConnect Cloud project id -- only needed if you add the walletConnect()
# connector for QR/mobile wallet support (see src/app/providers.tsx; this example's
# default injected() connector needs none). Get one free at
# https://cloud.walletconnect.com -- it is a PUBLIC client identifier, safe to
# expose via NEXT_PUBLIC_, never a secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# No @sweepnflip key exists and none is needed here. Every read in this app goes
# through YOUR OWN RPC via viem/wagmi; every write goes through the connected
# wallet. @sweepnflip/sdk never reads process.env itself (D-04) -- only this
# example app's own provider wiring does.

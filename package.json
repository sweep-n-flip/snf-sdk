{
  "name": "snf-sdk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "size-limit",
    "grep:gate": "node scripts/grep-gate.mjs",
    "test:fork": "pnpm --filter @sweepnflip/sdk test:fork",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.4",
    "fast-check": "4.10.2",
    "prettier": "3.9.8",
    "size-limit": "14.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.0.8",
    "vitest": "5.0.1"
  }
}

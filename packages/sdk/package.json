{
  "name": "@sweepnflip/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Headless TypeScript SDK for quoting and executing swaps against Sweep n' Flip NFT AMM pools. Client-direct, unsigned calldata only.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweep-n-flip/snf-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/sweep-n-flip/snf-sdk#readme",
  "bugs": {
    "url": "https://github.com/sweep-n-flip/snf-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "viem": "^2.47.0"
  },
  "devDependencies": {
    "viem": "^2.47.0"
  }
}

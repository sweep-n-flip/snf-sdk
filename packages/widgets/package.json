{
  "name": "@sweepnflip/widgets",
  "version": "0.0.0",
  "private": true,
  "description": "Headless React swap-widget kit for Sweep n' Flip NFT AMM swaps — SnfTradeCard and SnfPoolStats over @sweepnflip/sdk + @sweepnflip/sdk-react, styled entirely by the partner.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweep-n-flip/snf-sdk.git",
    "directory": "packages/widgets"
  },
  "homepage": "https://github.com/sweep-n-flip/snf-sdk#readme",
  "bugs": {
    "url": "https://github.com/sweep-n-flip/snf-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copyTheme.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "peerDependencies": {
    "@sweepnflip/sdk": "workspace:^",
    "@sweepnflip/sdk-react": "workspace:^",
    "@tanstack/react-query": "^5.90.21",
    "react": ">=18",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@sweepnflip/sdk": "workspace:*",
    "@sweepnflip/sdk-react": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "wagmi": "2.19.5"
  }
}
